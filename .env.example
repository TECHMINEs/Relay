# ============================================================================
# Relay gateway — copy to .env. Values match the built-in defaults, except storage URLs,
# which point at the host ports published by deploy/docker-compose.yml.
# Durations use Go syntax: 500ms, 30s, 2m
# ============================================================================

# --- HTTP server ---
PORT=8080
READ_TIMEOUT=30s
WRITE_TIMEOUT=120s
IDLE_TIMEOUT=60s

# --- Providers --- (mock | ollama)
DEFAULT_PROVIDER=mock
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT=60s

# --- Mock provider (chaos / load testing) ---
MOCK_LATENCY_MIN=0s
MOCK_LATENCY_MAX=0s
MOCK_ERROR_RATE=0.0
MOCK_STALL_FOREVER=false
MOCK_STREAM_CHUNK_LEN=5
MOCK_CHUNK_DELAY=10ms

# --- Circuit breaker (sliding window) ---
BREAKER_WINDOW_SIZE=20
BREAKER_FAILURE_THRESHOLD=0.5
BREAKER_MIN_REQUESTS=5
BREAKER_COOLDOWN=10s
BREAKER_MAX_HALF_OPEN_PROBES=1

# --- Retry with exponential backoff ---
RETRY_MAX_ATTEMPTS=3
RETRY_ATTEMPT_TIMEOUT=30s
RETRY_BASE_DELAY=100ms
RETRY_MAX_DELAY=30s

# --- Storage --- (host ports published by deploy/docker-compose.yml)
DATABASE_URL=postgres://postgres:postgres@localhost:5433/relay?sslmode=disable
REDIS_URL=redis://localhost:6380/0
